MONGO_URL=mongodb://localhost:27017
MONGO_DB=lukis
# Comma-separated if the frontend is reached under more than one origin.
FRONTEND_ORIGIN=http://localhost:3000
# S3-compatible object storage (RustFS, MinIO…) for images and thumbnails.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lukis
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Outgoing email, optional. Without SMTP_HOST there's no email verification
# or password reset, and invites are shared as links instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM='Lukis <noreply@localhost>'

# Logging in with Google, GitHub or Microsoft, optional. Each one is offered
# once its client ID and secret are set; see deploy/README.md. The redirect
# URI to register with each is <frontend origin>/api/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (any Microsoft account), organizations, consumers, or a tenant ID.
MICROSOFT_TENANT=common
