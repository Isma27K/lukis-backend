# Everything goes to Next.js, which passes /api (including the live-editing
# WebSockets) on to the backend. A domain in SITE_ADDRESS gets HTTPS
# certificates automatically; ":80" serves plain HTTP.

# Behind Cloudflare's proxy, connections come from Cloudflare's addresses
# (https://www.cloudflare.com/ips), and the visitor's is in CF-Connecting-IP.
# Only trusted from those addresses, so it can't be spoofed by connecting
# directly. Without Cloudflare this changes nothing.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Uploads are JSON. Images are at most 4 MB, a third more once encoded.
	request_body {
		max_size 16MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# X-Forwarded-For becomes just the visitor's real address (whatever they
	# sent is dropped), which the backend's rate limits rely on.
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}
