# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Caddy (HTTPS) and MongoDB come bundled. To use ones the server already
# runs instead, add their file to COMPOSE_FILE, separated by colons:
# - compose.own-proxy.yaml leaves Caddy out. Point your reverse proxy
#   (nginx…) at FRONTEND_PORT as nginx.conf.example shows. SITE_ADDRESS is
#   then unused, but keep it set: compose.yaml still asks for it.
# - compose.own-mongo.yaml leaves MongoDB out. Set MONGO_URL below.
# COMPOSE_FILE=compose.yaml:compose.own-proxy.yaml:compose.own-mongo.yaml
# FRONTEND_PORT=127.0.0.1:3000

# Where people reach Lukis.
# - A domain (lukis.example.com): Caddy gets HTTPS certificates for it
#   automatically. Point its DNS at this server and open ports 80 and 443.
# - ":80": plain HTTP, e.g. on a LAN. Then PUBLIC_URL is http://<server-ip>
#   and COOKIE_SECURE must be false, or logins won't stick.
SITE_ADDRESS=lukis.example.com
PUBLIC_URL=https://lukis.example.com
COOKIE_SECURE=true

# MongoDB's admin account, created on first start. Letters and digits only,
# since the password goes into a connection URL.
MONGO_USER=lukis
MONGO_PASSWORD=
# Or your own MongoDB (with compose.own-mongo.yaml), which makes the two
# above unused. Its user needs readWrite on MONGO_DB; a replica set isn't
# needed. One on this server itself is host.docker.internal.
# MONGO_URL=mongodb://lukis:<password>@host.docker.internal:27017/?authSource=admin
# MONGO_DB=lukis

# The first account becomes the site owner and needs a one-time setup code to
# register. By default a random one is printed in `docker compose logs
# backend`; set this to choose it instead (8+ letters or digits).
# SETUP_CODE=

# S3-compatible storage (RustFS, MinIO…) for images, thumbnails and backups.
S3_ENDPOINT=http://192.168.101.30:2222
S3_BUCKET=lukis
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outgoing email, optional. Without SMTP_HOST there's no email verification
# or password reset, and invites are shared as links instead of emailed.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Lukis <noreply@lukis.example.com>

# Daily database backups, under backups/ in the bucket (or BACKUP_BUCKET).
BACKUP_KEEP_DAYS=14

# Which published images to run: "latest", or a commit's "sha-<short sha>"
# tag to pin a version or roll back.
FRONTEND_TAG=latest
BACKEND_TAG=latest

# Logging in with Google, GitHub or Microsoft, optional. Each one is offered
# once its client ID and secret are set; see README.md. The redirect
# URI to register with each is PUBLIC_URL/api/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (any Microsoft account), organizations, consumers, or a tenant ID.
MICROSOFT_TENANT=common
