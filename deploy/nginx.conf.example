# Lukis behind your own nginx instead of Caddy (see README.md). Add to the
# nginx config, then adjust server_name and the certificate lines.

# Once, in the http block: WebSocket requests get "Connection: upgrade".
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name lukis.example.com;
    ssl_certificate     /etc/ssl/lukis/fullchain.pem;
    ssl_certificate_key /etc/ssl/lukis/privkey.pem;

    # Uploads are JSON. Images are at most 4 MB, a third more once encoded;
    # nginx's default is 1 MB.
    client_max_body_size 16m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        # FRONTEND_PORT in .env.
        proxy_pass http://127.0.0.1:3000;

        # Live editing runs over WebSockets.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Just the visitor's address, replacing whatever they sent: the
        # backend's rate limits rely on it. If nginx is itself behind another
        # proxy, set up its real_ip module so $remote_addr is the visitor's.
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 80;
    server_name lukis.example.com;
    return 301 https://$host$request_uri;
}
